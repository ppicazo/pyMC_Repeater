# Default Repeater Configuration

repeater:
  # Node name for logging and identification
  node_name: "mesh-repeater-01"

  # Geographic location (optional)
  # Latitude in decimal degrees (-90 to 90)
  latitude: 0.0
  # Longitude in decimal degrees (-180 to 180)
  longitude: 0.0

  # Path to identity file (public/private key)
  # If not specified, a new identity will be generated
  identity_file: null

  # Duplicate packet cache TTL in seconds
  cache_ttl: 60

  # Score-based transmission filtering
  # Enable quality-based packet filtering and adaptive delays
  use_score_for_tx: false

  # Score threshold for quality monitoring (future use)
  # Currently reserved for potential future features like dashboard alerts,
  # proactive statistics collection, or advanced filtering strategies.
  # Changing this value has no effect on current packet processing.
  score_threshold: 0.3

  # Automatic advertisement interval in hours
  # The repeater will send an advertisement packet at this interval
  # Set to 0 to disable automatic adverts (manual only via web interface)
  # Range: 0 (disabled) to 24+ hours
  # Recommended: 10 hours for typical deployments
  send_advert_interval_hours: 10

radio:
  # Frequency in Hz (869.618 MHz for EU)
  frequency: 869618000

  # TX power in dBm
  tx_power: 14

  # Bandwidth in Hz (62500 = 62.5 kHz)
  bandwidth: 62500

  # LoRa spreading factor (7-12)
  spreading_factor: 8

  # Coding rate (5-8)
  coding_rate: 8

  # Preamble length in symbols
  preamble_length: 17

  # Sync word (LoRa network ID)
  sync_word: 13380

  # Enable CRC checking
  crc_enabled: true

  # Use implicit header mode
  implicit_header: false

# SX1262 Hardware Configuration
sx1262:
  # SPI bus and chip select
  bus_id: 0
  cs_id: 0

  # GPIO pins (BCM numbering)
  cs_pin: 21
  reset_pin: 18
  busy_pin: 20
  irq_pin: 16

  # TX/RX enable pins (-1 to disable)
  txen_pin: -1
  rxen_pin: -1

  # LED pins for TX/RX indication (-1 to disable)
  txled_pin: -1
  rxled_pin: -1

  use_dio3_tcxo: false

  # Waveshare hardware flag
  is_waveshare: false

delays:
  # TX delay factor for flood mode (multiplier)
  tx_delay_factor: 1.0

  # TX delay factor for direct mode (faster)
  direct_tx_delay_factor: 0.5

duty_cycle:
  # Enable/disable duty cycle enforcement
  # Set to false to disable airtime limits
  enforcement_enabled: false

  # Maximum airtime per minute in milliseconds
  max_airtime_per_minute: 3600

logging:
  # Log level: DEBUG, INFO, WARNING, ERROR
  level: INFO

  # Log format
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# MQTT Configuration
# mqtt:
#   # Enable/disable MQTT publishing
#   enabled: false
# 
#   # MQTT broker settings
#   server: mqtt.example.com
#   port: 1883
#   # Select 'tcp' (default) or 'websockets' transport depending on your broker
#   transport: "tcp"
#   websocket_path: "/mqtt"
#   websocket_headers:
#     X-Forwarded-For: "mesh-repeater"
# 
#   # Authentication
#   # Leave empty to disable authentication
#   username: ""
#   password: ""
# 
#   # TLS/SSL settings
#   use_tls: false
#   tls_verify: true
# 
#   # MQTT topic templates
#   # Supported variables: {NODE_NAME}, {PUBLIC_KEY}
#   topic_status: "meshcore/{NODE_NAME}/status"
#   topic_packets: "meshcore/{NODE_NAME}/packets"
#   topic_raw: "meshcore/{NODE_NAME}/raw"
# 
#   # Auth-token (LetsMesh / letsme.sh) settings
#   auth_token:
#     # Toggle JWT-based authentication instead of static username/password
#     enabled: false
#
#     # Set to true to reuse the repeater's mesh identity key for signing JWTs
#     # Tokens are signed locally using the built-in MeshCore signer
#     use_mesh_identity_key: false
#
#     # Optional alternative private key sources (only one is required)
#     private_key_hex: ""
#     private_key_path: "/etc/pymc_repeater/letsmesh_prv.key"
#     private_key_env: "PYMC_REPEATER_MQTT_PRIVATE_KEY"
#
#     # Provide an existing token via env var or custom command instead of signing locally
#     token_env_var: ""  # e.g. AUTH_TOKEN
#     token_command: ""  # e.g. /usr/local/bin/fetch_token --aud {AUDIENCE}
#
#     # JWT claims and refresh tuning
#     token_audience: "mqtt-us-v1.letsmesh.net"
#     token_owner: ""
#     token_email: ""
#     token_ttl: 3600
#     token_refresh_margin: 300
#
#     # Username format applied when publishing via LetsMesh (default matches meshcoretomqtt)
#     username_template: "v1_{PUBLIC_KEY}"
# 
#   # MQTT client settings
#   client_id_prefix: "pymc_repeater"
#   # Some public brokers (LetsMesh) cap client IDs at 23 chars.
#   # Override if your broker allows longer identifiers.
#   client_id_max_length: 23
#   qos: 0
#   retain: false
#   keepalive: 60
